<div class="logregParent">
    <div class="logregCenter">
        <body>
        <div class="box-1" >
            <header>
                <h1>
                    Login
                </h1>
            </header> 
        </div>   
        <form id="logForm" method="POST" action="/users/login" enctype="application/x-www-form-urlencoded">
            <div class="box-2">
                    <input type="text" id="username" placeholder="Username" name="username"> <br>
                    <input type="password" id="password" placeholder="Password" name="password">
            </div>
            <a href="/register" id="reg-button" class="nav-items anchor-buttons">Don't have an account? Click Here!</a>
            <div class="box-3">
                    <button type="submit" id="logButton"> Submit </button>
            </div>  
        </form>
            
        </body>
    </div>
</div>